{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfactorycaresync"
		},
		"AzureSqlDatabase1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "caresyncserve.database.windows.net"
		},
		"AzureSqlDatabase1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "caresyncserve"
		},
		"AzureSqlDatabase1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "caresyncserve"
		},
		"postgresskeyvault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://neondbpassword.vault.azure.net/"
		},
		"postgrestoadf_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-square-sound-bbk5zfhj-pooler.c-15.us-east-1.aws.neon.tech"
		},
		"postgrestoadf_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"postgrestoadf_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"storagetoadf_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://pocstoargeacc.dfs.core.windows.net/"
		},
		"AzureDatabricks1_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1125-063407-ykw2ax7f"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfactorycaresync_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"postgresskeyvault_properties_typeProperties_baseUrl": {
						"value": "[parameters('postgresskeyvault_properties_typeProperties_baseUrl')]"
					},
					"storagetoadf_properties_typeProperties_url": {
						"value": "[parameters('storagetoadf_properties_typeProperties_url')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_server')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_database')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_userName": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_userName')]"
					},
					"postgrestoadf_properties_typeProperties_server": {
						"value": "[parameters('postgrestoadf_properties_typeProperties_server')]"
					},
					"postgrestoadf_properties_typeProperties_database": {
						"value": "[parameters('postgrestoadf_properties_typeProperties_database')]"
					},
					"postgrestoadf_properties_typeProperties_username": {
						"value": "[parameters('postgrestoadf_properties_typeProperties_username')]"
					},
					"AzureDatabricks1_properties_typeProperties_existingClusterId": {
						"value": "[parameters('AzureDatabricks1_properties_typeProperties_existingClusterId')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}